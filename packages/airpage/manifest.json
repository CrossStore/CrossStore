{
  "schema": 1,
  "id": "airpage",
  "version": "0.3.0",
  "name": {
    "en": "AirPage",
    "zh": "AirPage"
  },
  "description": {
    "en": "Send images with a QR code, keep a history, receive live updates and set sleep wallpaper.",
    "zh": "扫码传图、历史图片、实时接收与休眠壁纸。"
  },
