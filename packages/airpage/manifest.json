    "psram"
  ],
  "status": "ready",
  "source": "https://github.com/CrossStore/CrossStore/tree/main/packages/airpage",
  "assets": [
    "assets/icon-g2-32.bin",
    "assets/icon-g2-64.bin",
    "assets/icon-g4-32.bin",
    "assets/icon-g4-64.bin",
    "assets/icon-g16-32.bin",
    "assets/icon-g16-96.bin"
  ],
  "permissions": [
    "network",
    "device_info",
    "wallpaper",
    "keep_awake"
  ]
}
